#!/usr/bin/env bash
set -eu

case "$(uname -s)-$(uname -m)" in
  MINGW*|MSYS*|CYGWIN*) target="windows-x64.exe" ;;
  Darwin-arm64) target="macos-arm64" ;;
  Darwin-x86_64) target="macos-x64" ;;
  *) echo "sp-cli: unsupported platform $(uname -s)-$(uname -m)" >&2; exit 1 ;;
esac

root="$(cd "$(dirname "$0")/.." && pwd)"
bin="$root/dist/sp-cli-$target"
if [ ! -f "$bin" ]; then
  # A copy without binaries (a text-only marketplace) fetches this version's release binary once,
  # checked against dist/SHA256SUMS. dist/VERSION names the release.
  sums="$root/dist/SHA256SUMS"
  [ -f "$sums" ] && [ -f "$root/dist/VERSION" ] || { echo "sp-cli: no binary at $bin and no $sums or dist/VERSION" >&2; exit 1; }
  version="$(tr -d ' \r\n' < "$root/dist/VERSION")"
  cache="${SP_STATE_DIR:-$HOME/.claude/state}/sp-cli/bin/$version"
  bin="$cache/sp-cli-$target"
  if [ ! -f "$bin" ]; then
    mkdir -p "$cache"
    url="${SP_CLI_DOWNLOAD_BASE:-https://github.com/damithdev/claude-super-productivity/releases/download}/v$version/sp-cli-$target"
    part="$bin.part.$$"
    curl -fsSL "$url" -o "$part" || { rm -f "$part"; echo "sp-cli: download failed: $url" >&2; exit 1; }
    want="$(grep " \*\{0,1\}sp-cli-$target\$" "$sums" | cut -d' ' -f1)"
    got="$( (sha256sum "$part" 2>/dev/null || shasum -a 256 "$part") | cut -d' ' -f1)"
    if [ -z "$want" ] || [ "$want" != "$got" ]; then
      rm -f "$part"
      echo "sp-cli: checksum mismatch for $url" >&2
      exit 1
    fi
    chmod +x "$part"
    mv -f "$part" "$bin"
  fi
fi
exec "$bin" "$@"
